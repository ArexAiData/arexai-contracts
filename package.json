{
  "name": "arexai-contracts",
  "version": "1.0.0",
  "private": true,
  "description": "Public smart-contract sources and automated tests for ArexAi (ARXAI)",
  "type": "module",
  "engines": {
    "node": ">=22.13.0"
  },
  "scripts": {
    "compile": "hardhat build",
    "test": "hardhat test nodejs",
    "verify:registry": "node scripts/verify-registry.mjs",
    "verify:bytecode": "node scripts/verify-bytecode.mjs",
    "staking:prepare": "node scripts/prepare-staking-testnet.mjs",
    "verify:docs": "node scripts/generate-deployment-table.mjs --check",
    "docs:generate": "node scripts/generate-deployment-table.mjs",
    "verify:ai-examples": "node scripts/verify-ai-examples.mjs",
    "audit:dependencies": "npm audit --audit-level=high",
    "verify:safe": "node scripts/verify-safe.mjs",
    "review:package": "node scripts/build-review-package.mjs",
    "review:verify": "node scripts/verify-review-package.mjs",
    "test:tooling": "node --test scripts/test-review-package.mjs",
    "verify:staking-mainnet": "node scripts/verify-staking-mainnet.mjs",
    "staking:snapshot": "node scripts/capture-staking-snapshot.mjs",
    "verify:consistency": "node scripts/verify-project-consistency.mjs",
    "test:consistency": "node --test scripts/test-project-consistency.mjs"
  },
  "dependencies": {
    "@openzeppelin/contracts": "5.4.0"
  },
  "devDependencies": {
    "@nomicfoundation/hardhat-ethers": "4.2.0",
    "@nomicfoundation/hardhat-node-test-runner": "3.1.0",
    "@safe-global/safe-deployments": "1.37.63",
    "@types/node": "22.19.19",
    "ethers": "6.17.0",
    "hardhat": "3.18.1",
    "solc": "0.8.24",
    "typescript": "5.9.3"
  },
  "packageManager": "npm@11.9.0",
  "overrides": {
    "solc": {
      "tmp": "0.2.7"
    }
  }
}
